# Coinbase Advanced Trade API
COINBASE_API_KEY=your_key_here
COINBASE_API_SECRET=your_secret_here

# Binance API
BINANCE_API_KEY=your_key_here
BINANCE_API_SECRET=your_secret_here

# Bybit API (опционально)
BYBIT_API_KEY=your_key_here
BYBIT_API_SECRET=your_secret_here

# Execution mode
# DRY_RUN=false  # раскомментировать когда готов к реальной торговле
DRY_RUN=true

# Максимальный размер одной сделки в USD
# Система возьмёт min(MAX_TRADE_USD, стакан биржи)
MAX_TRADE_USD=300

# Капитал на каждой бирже (для расчёта реальной прибыли в дашборде)
CAPITAL_PER_EXCHANGE=300

# Максимальный дневной убыток в USD (защита)
MAX_DAILY_LOSS_USD=30
